# ---------------------------------------------------------------------
# Smart Career Navigator — local secrets template
# Copy this file to "local.env" (same folder) and fill in your keys.
# The app loads it from <project>/../local.env  (i.e. next to this file).
# Never commit the real local.env — it is git-ignored.
# ---------------------------------------------------------------------

# Required: Claude advisor + natural-language query understanding
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: only needed for the live "Scrape Now" feature (Israeli jobs tab).
# Search over the bundled pre-scraped jobs works without it.
APIFY_TOKEN=

# Optional: A/B test backend. "anthropic" (default) -> claude-sonnet-4-6
#                            "openai"            -> gpt-5.4-mini-2026-03-17
LLM_BACKEND=anthropic
# OPENAI_API_KEY=        # only if LLM_BACKEND=openai
